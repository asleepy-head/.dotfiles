-- Central function to handle adaptive key presses
local function go_to_relative_workspace(key_num, move_window)
    local active_id = hl.get_active_workspace().id
    local base = 1

    -- Determine the correct base workspace multiplier for the active monitor
    if active_id >= 1 and active_id <= 3 then
        base = 0  -- Monitor 1 uses: 0 + key_num (1, 2, 3)
    elseif active_id >= 4 and active_id <= 6 then
        base = 3  -- Monitor 2 uses: 3 + key_num (4, 5, 6)
    elseif active_id >= 7 and active_id <= 9 then
        base = 6  -- Monitor 3 uses: 6 + key_num (7, 8, 9)
    else
        return -- Do nothing if focused outside your 3-monitor layout
    end

    local target = base + key_num

    -- Execute dispatchers dynamically
    if move_window then
        hl.dispatch(hl.dsp.window.move({ workspace = tostring(target) }))
    else
        hl.dispatch(hl.dsp.workspace({ workspace = tostring(target) }))
    end
end

-- Map keys 1 through 3 dynamically

for i = 1, 3 do
    -- Switch to local workspace i (e.g., SUPER + 2 jumps to 2, 5, or 8)
    hl.bind(Mod .. " + " .. i, function() go_to_relative_workspace(i, false) end)
    
    -- Move active window to local workspace i (e.g., SUPER + SHIFT + 2 moves window to 2, 5, or 8)
    hl.bind(Mod .. " + SHIFT + " .. i, function() go_to_relative_workspace(i, true) end)
end
